# ============================================================
# GFS Akomodasi - Environment Variables
# ============================================================
# Salin file ini: cp .env.example .env
# Isi semua nilai yang kosong sebelum menjalankan docker compose
# ============================================================

# ----------------------------------------------------------
# Database MySQL
# ----------------------------------------------------------
MYSQL_ROOT_PASSWORD=gantiBuatPasswordRootYangKuat
MYSQL_DATABASE=gfs_akomodasi_db
MYSQL_USER=gfs_user
MYSQL_PASSWORD=gantiBuatPasswordUserYangKuat

# ----------------------------------------------------------
# Backend PHP
# ----------------------------------------------------------
APP_ALLOWED_ORIGINS=*
APP_TIMEZONE=Asia/Makassar

# ----------------------------------------------------------
# Frontend: URL API yang diakses dari browser
# Gunakan domain publik Anda (Cloudflare tunnel domain)
# Contoh: https://siakmo.devraffi.my.id/api
# ----------------------------------------------------------
VITE_API_BASE_URL=https://DOMAIN_ANDA/api

# ----------------------------------------------------------
# Cloudflare Tunnel Token
# Dapatkan dari: https://one.dash.cloudflare.com/
# Zero Trust > Tunnels > Create a tunnel > Docker
# ----------------------------------------------------------
TUNNEL_TOKEN=ISI_TUNNEL_TOKEN_DARI_CLOUDFLARE_DASHBOARD
